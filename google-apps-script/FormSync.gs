// ------------------------------------------------------------------------------
// Supabase calls
// ------------------------------------------------------------------------------
function supabaseHeaders_() {
  return {
    "apikey": SUPABASE_ANON_KEY,
    "Authorization": "Bearer " + SUPABASE_ANON_KEY,
    "Content-Type": "application/json"
  };
}

function findMemberId_(query) {
  try {
    var res = UrlFetchApp.fetch(SUPABASE_URL + "?" + query + "&select=id&limit=1",
      { method: "get", headers: supabaseHeaders_(), muteHttpExceptions: true });
    if (res.getResponseCode() === 200) {
      var rows = JSON.parse(res.getContentText());
      if (rows && rows.length > 0) return rows[0].id;
    }
  } catch (err) {}
  return null;
}

// Sends the request; if Supabase rejects an unknown column (PGRST204) that column is dropped and the request retried,
// so one missing column can no longer make the whole member fail to save.
function sendToSupabase_(method, url, payload, extraHeaders) {
  var headers = supabaseHeaders_();
  for (var k in (extraHeaders || {})) headers[k] = extraHeaders[k];

  for (var attempt = 0; attempt < 40; attempt++) {
    var res = UrlFetchApp.fetch(url, { method: method, headers: headers, payload: JSON.stringify(payload), muteHttpExceptions: true });
    var code = res.getResponseCode();
    if (code >= 200 && code < 300) return true;

    var body = res.getContentText();
    var missing = /Could not find the '([^']+)' column/.exec(body);
    if (code === 400 && missing && payload.hasOwnProperty(missing[1])) {
      delete payload[missing[1]];
      continue;
    }
    Logger.log("Supabase " + method + " failed (" + code + "): " + body);
    return false;
  }
  return false;
}

function upsertMemberToSupabase(payload) {
  var existingId = null;

  if (payload.email) existingId = findMemberId_("email=eq." + encodeURIComponent(payload.email));
  if (!existingId && payload.mobile_phone) existingId = findMemberId_("mobile_phone=eq." + encodeURIComponent(payload.mobile_phone));
  if (!existingId && payload.first_name && payload.surname) {
    existingId = findMemberId_("first_name=ilike." + encodeURIComponent(payload.first_name) +
      "&surname=ilike." + encodeURIComponent(payload.surname));
  }

  if (existingId) {
    payload.updated_at = new Date().toISOString();
    sendToSupabase_("patch", SUPABASE_URL + "?id=eq." + existingId, payload);
  } else {
    payload.created_at = new Date().toISOString();
    sendToSupabase_("post", SUPABASE_URL, payload, { "Prefer": "return=minimal" });
  }
}

// ------------------------------------------------------------------------------
// App payload -> Google Sheet header (used by doPost)
// ------------------------------------------------------------------------------
function getPayloadValueForHeader(h, p) {
  if (h.indexOf("membership id") !== -1) return p.membership_id || p.member_code;
  if (h.indexOf("generational group") !== -1) return p.primary_generational_group || p.generational_group;
  if (h === "title") return p.title;
  if (h.indexOf("first name") !== -1) return p.first_name;
  if (h.indexOf("surname") !== -1 || h.indexOf("last name") !== -1) return p.surname || p.last_name;
  if (h === "sex" || h === "gender") return p.sex || p.gender;
  if (h.indexOf("date of birth") !== -1) return p.date_of_birth;
  if (h.indexOf("photo") !== -1 || h.indexOf("picture") !== -1) return p.photo_url || p.passport_picture;
  if (h.indexOf("communicant") !== -1) return p.communicant_status;
  if (h.indexOf("mobile phone") !== -1) return p.mobile_phone || p.phone_number;
  if (h.indexOf("residential phone") !== -1) return p.residential_phone;
  if (h.indexOf("other phone") !== -1) return p.other_phone;
  if (h.indexOf("email") !== -1) return p.email;
  if (h === "member status" || h === "status") return p.status || p.member_status;
  if (h.indexOf("distant member") !== -1) return p.is_distant_member === undefined ? undefined : (p.is_distant_member ? "Yes" : "No");
  if (h.indexOf("marital status") !== -1) return p.marital_status;
  if (h.indexOf("marriage type") !== -1) return p.marriage_type;
  if (h.indexOf("spouse name") !== -1) return p.spouse_name;
  if (h.indexOf("spouse contact") !== -1 || h.indexOf("spouse phone") !== -1) return p.spouse_phone || p.spouse_contact;
  if (h.indexOf("children names") !== -1) return p.children_names;
  if (h.indexOf("children contacts") !== -1) return p.children_contacts;
  if (h.indexOf("parent") !== -1 || h.indexOf("guardian") !== -1) return p.parent_guardian_name;
  if (h.indexOf("relationship type") !== -1) return p.relationship_type;
  if (h.indexOf("profession") !== -1) return p.profession;
  if (h.indexOf("occupation") !== -1) return p.occupation;
  if (h.indexOf("special interest") !== -1) return p.special_interests;
  if (h.indexOf("interest group") !== -1) return p.interest_groups;
  if (h.indexOf("home town") !== -1 || h.indexOf("hometown") !== -1) return p.home_town;
  if (h.indexOf("place of birth") !== -1) return p.place_of_birth;
  if (h.indexOf("nationality") !== -1) return p.nationality;
  if (h.indexOf("residence") !== -1) return p.residence_area || p.residential_area;
  if (h.indexOf("landmark") !== -1 || h.indexOf("nearby location") !== -1 || h.indexOf("area description") !== -1) return p.area_description || p.landmark;
  if (h.indexOf("house number") !== -1) return p.house_number;
  if (h.indexOf("street name") !== -1) return p.street_name;
  if (h.indexOf("postal address") !== -1) return p.postal_address;
  if (h.indexOf("emergency contact name") !== -1) return p.emergency_contact_name || p.emergency_name;
  if (h.indexOf("emergency contact phone") !== -1) return p.emergency_contact_phone || p.emergency_phone;
  if (h.indexOf("joined new life") !== -1 && h.indexOf("estimated") === -1) return p.date_joined_new_life || p.date_joined;
  if (h.indexOf("joined new life") !== -1) return p.date_joined_new_life_is_estimated ? "Yes" : "No";
  if (h.indexOf("joined pcg") !== -1 && h.indexOf("estimated") === -1) return p.date_joined_pcg;
  if (h.indexOf("joined pcg") !== -1) return p.date_joined_pcg_is_estimated ? "Yes" : "No";
  if (h === "family") return p.family_group || p.family;
  if (h.indexOf("baptism date") !== -1) return p.baptism_date;
  if (h.indexOf("baptised by") !== -1) return p.baptised_by;
  if (h.indexOf("confirmation date") !== -1) return p.confirmation_date;
  if (h.indexOf("local congregation") !== -1) return p.local_congregation;
  if (h.indexOf("district") !== -1) return p.district;
  if (h.indexOf("presbytery") !== -1) return p.presbytery;
  if (h.indexOf("memory verse") !== -1) return p.memory_verse;
  return undefined;
}

// ==============================================================================
// DIAGNOSTIC — simulate a form submit using the last sheet row (check View > Logs)
// ==============================================================================
function testFormSubmitWithLastRow() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) { Logger.log("No data rows found!"); return; }

  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var values = sheet.getRange(lastRow, 1, 1, sheet.getLastColumn()).getValues()[0];
  var namedValues = {};
  for (var i = 0; i < headers.length; i++) {
    var h = String(headers[i]).trim();
    if (h && h !== "Timestamp") namedValues[h] = [values[i]];
  }
  onFormSubmit({ namedValues: namedValues });
}
