// Sheet dates are month/day/year (11/6/2000 = 6 Nov 2000). Returns YYYY-MM-DD or null.
function toIsoDate_(value) {
  if (value === null || value === undefined || value === "") return null;
  var y, m, d;
  if (Object.prototype.toString.call(value) === "[object Date]") {
    if (isNaN(value.getTime())) return null;
    y = value.getFullYear(); m = value.getMonth() + 1; d = value.getDate();
  } else {
    var text = String(value).trim();
    var iso = /^(\d{4})-(\d{1,2})-(\d{1,2})/.exec(text);
    var us = /^(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{4})$/.exec(text);
    if (iso) { y = +iso[1]; m = +iso[2]; d = +iso[3]; }
    else if (us) { m = +us[1]; d = +us[2]; y = +us[3]; }
    else return null;
  }
  var check = new Date(y, m - 1, d);
  if (check.getFullYear() !== y || check.getMonth() !== m - 1 || check.getDate() !== d) return null;
  return y + "-" + ("0" + m).slice(-2) + "-" + ("0" + d).slice(-2);
}

// Sheets drop the leading 0 of phone numbers typed as numbers (246636026 -> 0246636026).
function normalizePhone_(value) {
  var digits = String(value === null || value === undefined ? "" : value).replace(/[^\d+]/g, "");
  if (/^\d{9}$/.test(digits)) return "0" + digits;
  if (/^233\d{9}$/.test(digits)) return "0" + digits.slice(3);
  return digits;
}

function titleCase_(text) {
  return String(text).toLowerCase().replace(/(^|[\s\-'])([a-z])/g, function (m, a, b) { return a + b.toUpperCase(); });
}

function formatGoogleDriveUrl(rawUrl) {
  if (!rawUrl) return "";
  var firstUrl = String(rawUrl).split(",")[0].trim();
  var fileId = "";
  var idMatch = firstUrl.match(/id=([a-zA-Z0-9_-]+)/) || firstUrl.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (idMatch && idMatch[1]) fileId = idMatch[1];
  else if (firstUrl.length > 20 && firstUrl.indexOf("/") === -1 && firstUrl.indexOf("http") === -1) fileId = firstUrl;

  if (fileId) {
    try {
      DriveApp.getFileById(fileId).setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    } catch (e) {}
    return "https://lh3.googleusercontent.com/d/" + fileId;
  }
  return firstUrl;
}

// Google Form / Sheet header -> Supabase column(s)
function mapFieldToPayload(rawTitle, rawAnswer, payload) {
  if (rawAnswer === null || rawAnswer === undefined) return;
  var answer = (rawAnswer instanceof Date)
    ? Utilities.formatDate(rawAnswer, Session.getScriptTimeZone(), "yyyy-MM-dd")
    : String(rawAnswer).trim();
  if (answer === "") return;

  var title = String(rawTitle).toLowerCase().trim();
  var isYes = (answer.toLowerCase() === "yes" || answer.toLowerCase() === "true");

  if (title.indexOf("membership id") !== -1) return; // generated by the database
  if (title.indexOf("generational group") !== -1) {
    payload.primary_generational_group = answer;
    payload.generational_group = answer;
  } else if (title === "title") {
    payload.title = answer;
  } else if (title.indexOf("first name") !== -1) {
    payload.first_name = answer;
  } else if (title.indexOf("surname") !== -1 || title.indexOf("last name") !== -1) {
    payload.surname = answer;
  } else if (title === "sex" || title === "gender") {
    payload.sex = titleCase_(answer);
  } else if (title.indexOf("date of birth") !== -1) {
    var dob = toIsoDate_(answer);
    if (dob) payload.date_of_birth = dob;
  } else if (title.indexOf("photo") !== -1 || title.indexOf("picture") !== -1) {
    var url = formatGoogleDriveUrl(answer);
    payload.photo_url = url;
    payload.passport_picture = url;
  } else if (title.indexOf("communicant") !== -1) {
    payload.communicant_status = answer;
  } else if (title.indexOf("mobile phone") !== -1) {
    payload.mobile_phone = normalizePhone_(answer);
  } else if (title.indexOf("residential phone") !== -1) {
    payload.residential_phone = normalizePhone_(answer);
  } else if (title.indexOf("other phone") !== -1) {
    payload.other_phone = normalizePhone_(answer);
  } else if (title.indexOf("email") !== -1) {
    payload.email = answer.toLowerCase();
  } else if (title === "member status" || title === "status") {
    payload.status = titleCase_(answer);
  } else if (title.indexOf("distant member") !== -1) {
    payload.is_distant_member = isYes;
  } else if (title.indexOf("marital status") !== -1) {
    payload.marital_status = answer;
  } else if (title.indexOf("marriage type") !== -1) {
    payload.marriage_type = answer;
  } else if (title.indexOf("spouse name") !== -1) {
    payload.spouse_name = answer;
  } else if (title.indexOf("spouse contact") !== -1 || title.indexOf("spouse phone") !== -1) {
    payload.spouse_phone = normalizePhone_(answer);
  } else if (title.indexOf("spouse") !== -1 && title.indexOf("address") !== -1) {
    payload.spouse_postal_address = answer;
  } else if (title.indexOf("children names") !== -1) {
    payload.children_names = answer;
  } else if (title.indexOf("children contacts") !== -1) {
    payload.children_contacts = answer;
  } else if (title.indexOf("parent") !== -1 || title.indexOf("guardian") !== -1) {
    payload.parent_guardian_name = answer;
  } else if (title.indexOf("relationship type") !== -1) {
    payload.relationship_type = answer;
  } else if (title.indexOf("profession") !== -1) {
    payload.profession = answer;
  } else if (title.indexOf("occupation") !== -1) {
    payload.occupation = answer;
  } else if (title.indexOf("special interest") !== -1) {
    payload.special_interests = answer;
  } else if (title.indexOf("interest group") !== -1) {
    payload.interest_groups = answer;
  } else if (title.indexOf("home town") !== -1 || title.indexOf("hometown") !== -1) {
    payload.home_town = answer;
  } else if (title.indexOf("place of birth") !== -1) {
    payload.place_of_birth = answer;
  } else if (title.indexOf("nationality") !== -1) {
    payload.nationality = answer;
  } else if (title.indexOf("residence") !== -1) {
    payload.residence_area = answer;
    payload.residential_area = answer;
    payload.current_place_of_residence = answer;
  } else if (title.indexOf("landmark") !== -1 || title.indexOf("nearby location") !== -1 || title.indexOf("area description") !== -1) {
    payload.area_description = answer;
    payload.landmark = answer;
  } else if (title.indexOf("house number") !== -1) {
    payload.house_number = answer;
  } else if (title.indexOf("street name") !== -1) {
    payload.street_name = answer;
  } else if (title.indexOf("postal address") !== -1) {
    payload.postal_address = answer;
  } else if (title.indexOf("emergency contact name") !== -1) {
    payload.emergency_contact_name = answer;
  } else if (title.indexOf("emergency contact phone") !== -1) {
    payload.emergency_contact_phone = normalizePhone_(answer);
  } else if (title.indexOf("joined new life") !== -1) {
    if (title.indexOf("estimated") !== -1) payload.date_joined_new_life_is_estimated = isYes;
