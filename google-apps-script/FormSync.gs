// ==============================================================================
// PCG New Life — Google Form / Sheet  <->  Supabase sync
// Membership ID is generated by the database, so it is NOT read from the form.
// ==============================================================================
var SUPABASE_URL = "https://wnchkbdfabqbjyuobgdz.supabase.co/rest/v1/members";
var SUPABASE_ANON_KEY = "PASTE_YOUR_ANON_KEY_HERE";

var DATE_FIELDS = ["date_of_birth", "date_joined_new_life", "date_joined_pcg", "baptism_date", "confirmation_date"];

// ==============================================================================
// 1. BULK SYNC — push every existing row of the active sheet into Supabase
// ==============================================================================
function syncAllExistingRows() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var data = sheet.getDataRange().getValues();
  if (data.length < 2) return;

  var headers = data[0];
  var successCount = 0;

  for (var r = 1; r < data.length; r++) {
    var payload = {};
    for (var c = 0; c < headers.length; c++) {
      var header = String(headers[c]).trim();
      if (header === "Timestamp" || header === "") continue;
      mapFieldToPayload(header, data[r][c], payload);
    }
    if (!payload.first_name && !payload.surname && !payload.email && !payload.mobile_phone) continue;
    upsertMemberToSupabase(payload);
    successCount++;
  }
  Logger.log("Synced " + successCount + " row(s).");
}

// ==============================================================================
// 2. FORM SUBMIT TRIGGER — runs on every new Google Form response
// ==============================================================================
function onFormSubmit(e) {
  if (!e) {
    Logger.log("Manual run — use syncAllExistingRows() or testFormSubmitWithLastRow().");
    return;
  }
  var payload = {};

  if (e.namedValues) {
    for (var title in e.namedValues) {
      if (title === "Timestamp") continue;
      var raw = e.namedValues[title];
      mapFieldToPayload(title, Array.isArray(raw) ? raw.join(", ") : raw, payload);
    }
  } else if (e.response && typeof e.response.getItemResponses === "function") {
    var items = e.response.getItemResponses();
    for (var i = 0; i < items.length; i++) {
      var ans = items[i].getResponse();
      mapFieldToPayload(items[i].getItem().getTitle(), Array.isArray(ans) ? ans.join(", ") : ans, payload);
    }
  }

  if (Object.keys(payload).length > 0) upsertMemberToSupabase(payload);
}

// ==============================================================================
// 3. WEBHOOK — App -> Google Sheet (create / update / delete)
// ==============================================================================
function jsonOut_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) return jsonOut_({ status: "error", message: "No post data received" });

    var contents = JSON.parse(e.postData.contents);
    var action = contents.action;
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    var data = sheet.getDataRange().getValues();
    if (data.length < 1) return jsonOut_({ status: "empty" });

    var headers = data[0];
    var colMap = {};
    for (var c = 0; c < headers.length; c++) colMap[String(headers[c]).trim().toLowerCase()] = c;

    var targetRowIndex = -1;
    if (action === "update" || action === "delete") {
      var mEmail = contents.matchEmail ? String(contents.matchEmail).trim().toLowerCase() : "";
      var mPhone = contents.matchPhone ? normalizePhone_(contents.matchPhone) : "";
      var mFirst = contents.matchFirst ? String(contents.matchFirst).trim().toLowerCase() : "";
      var mLast = contents.matchLast ? String(contents.matchLast).trim().toLowerCase() : "";
      var lastCol = colMap["surname"] !== undefined ? colMap["surname"] : colMap["last name"];

      for (var r = 1; r < data.length; r++) {
        var row = data[r];
        var rEmail = colMap["email address"] !== undefined ? String(row[colMap["email address"]]).trim().toLowerCase() : "";
        var rPhone = colMap["mobile phone"] !== undefined ? normalizePhone_(row[colMap["mobile phone"]]) : "";
        var rFirst = colMap["first name"] !== undefined ? String(row[colMap["first name"]]).trim().toLowerCase() : "";
        var rLast = lastCol !== undefined ? String(row[lastCol]).trim().toLowerCase() : "";

        if ((mEmail && rEmail === mEmail) || (mPhone && rPhone === mPhone) ||
            (mFirst && mLast && rFirst === mFirst && rLast === mLast)) {
          targetRowIndex = r;
          break;
        }
      }
    }

    if (action === "delete") {
      if (targetRowIndex === -1) return jsonOut_({ status: "not_found" });
      sheet.deleteRow(targetRowIndex + 1);
      return jsonOut_({ status: "success", message: "Row deleted" });
    }

    if (action === "update" || action === "create") {
      var p = contents.payload || {};
      var rowValues = targetRowIndex !== -1 ? data[targetRowIndex].slice() : new Array(headers.length).fill("");

      for (var k = 0; k < headers.length; k++) {
        var v = getPayloadValueForHeader(String(headers[k]).trim().toLowerCase(), p);
        if (v !== undefined && v !== null && v !== "") rowValues[k] = v;
      }

      if (action === "update" && targetRowIndex !== -1) {
        sheet.getRange(targetRowIndex + 1, 1, 1, headers.length).setValues([rowValues]);
        return jsonOut_({ status: "success", message: "Row updated" });
      }
      if (!rowValues[0]) rowValues[0] = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm:ss");
      sheet.appendRow(rowValues);
      return jsonOut_({ status: "success", message: "Row created" });
    }

    return jsonOut_({ status: "invalid_action" });
  } catch (err) {
    return jsonOut_({ status: "error", message: err.toString() });
  }
}

